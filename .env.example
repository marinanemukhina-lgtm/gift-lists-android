# Server-only PostgreSQL credential, supplied through hosting secret storage only.
DATABASE_URL=
# Exact HTTPS web origin plus Android local origin (https://localhost), comma-separated.
ALLOWED_ORIGINS=https://example.vercel.app,https://localhost
DEMO_MODE=true
TRUST_PROXY=false
# Operator contact must be real/approved before release. Demo reports are stored in SQL.
SUPPORT_CONTACT=
NEXT_PUBLIC_DEMO=true
# Empty web origins use current web HTTPS origin; native origins must be configured separately.
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_PUBLIC_ORIGIN=
NEXT_PUBLIC_SUPPORT_CONTACT=
VITE_API_ORIGIN=
VITE_PUBLIC_ORIGIN=
VITE_DEMO=true
VITE_SUPPORT_CONTACT=
