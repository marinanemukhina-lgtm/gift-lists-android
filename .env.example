# Server-only PostgreSQL credential, supplied through hosting secret storage only.
DATABASE_URL=
# Exact HTTPS web origin plus Android local origin (https://localhost), comma-separated.
ALLOWED_ORIGINS=
DEMO_MODE=true
TRUST_PROXY=false
# Operator contact must be real/approved before release. Demo reports are stored in SQL.
SUPPORT_CONTACT=
NEXT_PUBLIC_DEMO=true
# Empty web origins use current web HTTPS origin; native origins must be configured separately.
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_PUBLIC_ORIGIN=
NEXT_PUBLIC_SUPPORT_CONTACT=
VITE_API_ORIGIN=
VITE_PUBLIC_ORIGIN=
VITE_DEMO=true
VITE_SUPPORT_CONTACT=

# Public release identity and legal links: leave empty for offline/synthetic demo.
# Production requires all of these, exact HTTPS origins, and explicit operator approval.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_LEGAL_APPROVED=false
VITE_OPERATOR_NAME=
VITE_PRIVACY_POLICY_URL=
VITE_SUPPORT_URL=
VITE_LEGAL_APPROVED=false
# Server-side approved policy text and ISO calendar revision date; never a draft template.
GIFT_LEGAL_APPROVED=false
GIFT_PRIVACY_TEXT=
GIFT_PRIVACY_UPDATED_AT=
